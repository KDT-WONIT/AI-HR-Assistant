digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.8", nodesep="0.4", ranksep="0.65", splines=polyline, fontname="Malgun Gothic", fontsize=23, label="WONIT AI 업무 도우미 · 현재 서비스 ERD", labelloc=t, labeljust=l];
node [shape=plain, fontname="Arial", fontsize=14];
edge [dir=both, color="#7b8ba1", penwidth=1.15, arrowsize=0.75, fontname="Malgun Gothic", fontsize=11];
subgraph cluster_directory { label="사원·조직 / 읽기 전용 디렉터리"; color="#cbd4df"; margin=22; fontsize=19;
