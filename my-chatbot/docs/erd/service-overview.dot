"directory_employees":"employee_id_out":e -> "app_conversations":"employee_id_in":w [style=dashed, color="#9a6b25", arrowtail=none, arrowhead=vee, label="employee_id · 코드 연결", fontcolor="#805414"];
"chroma_active_collections":"id_out":e -> "chroma_active_segments":"collection_in":w [style=dashed, color="#9a6b25", arrowtail=none, arrowhead=vee, label="collection · 논리 연결", fontcolor="#805414"];
