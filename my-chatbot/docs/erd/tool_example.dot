digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.8", nodesep="0.4", ranksep="0.65", splines=polyline, fontname="Malgun Gothic", fontsize=23, label="제공 Tool · 예시 스키마 5개 테이블", labelloc=t, labeljust=l];
node [shape=plain, fontname="Arial", fontsize=14];
edge [dir=both, color="#7b8ba1", penwidth=1.15, arrowsize=0.75, fontname="Malgun Gothic", fontsize=11];
"contacts" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#ccd5df"><TR><TD COLSPAN="2" BGCOLOR="#f0f1f3"><B>contacts</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">DDL 정의</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="contact_id_in">contact_id</TD><TD WIDTH="95" ALIGN="LEFT" PORT="contact_id_out"><FONT COLOR="#53647a">PK</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="name_in">name</TD><TD WIDTH="95" ALIGN="LEFT" PORT="name_out"><FONT COLOR="#53647a">TEXT</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="department_in">department</TD><TD WIDTH="95" ALIGN="LEFT" PORT="department_out"><FONT COLOR="#53647a">TEXT</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="topic_in">topic</TD><TD WIDTH="95" ALIGN="LEFT" PORT="topic_out"><FONT COLOR="#53647a">TEXT</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="keywords_json_in">keywords_json</TD><TD WIDTH="95" ALIGN="LEFT" PORT="keywords_json_out"><FONT COLOR="#53647a">TEXT</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="phone_in">phone</TD><TD WIDTH="95" ALIGN="LEFT" PORT="phone_out"><FONT COLOR="#53647a">TEXT</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="email_in">email</TD><TD WIDTH="95" ALIGN="LEFT" PORT="email_out"><FONT COLOR="#53647a">TEXT</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="is_active_in">is_active</TD><TD WIDTH="95" ALIGN="LEFT" PORT="is_active_out"><FONT COLOR="#53647a">INTEGER</FONT></TD></TR></TABLE>>];
"employees" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#ccd5df"><TR><TD COLSPAN="2" BGCOLOR="#f0f1f3"><B>employees</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">DDL 정의</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="employee_id_in">employee_id</TD><TD WIDTH="95" ALIGN="LEFT" PORT="employee_id_out"><FONT COLOR="#53647a">PK</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="name_in">name</TD><TD WIDTH="95" ALIGN="LEFT" PORT="name_out"><FONT COLOR="#53647a">TEXT</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="department_in">department</TD><TD WIDTH="95" ALIGN="LEFT" PORT="department_out"><FONT COLOR="#53647a">TEXT</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="job_title_in">job_title</TD><TD WIDTH="95" ALIGN="LEFT" PORT="job_title_out"><FONT COLOR="#53647a">TEXT</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="travel_grade_in">travel_grade</TD><TD WIDTH="95" ALIGN="LEFT" PORT="travel_grade_out"><FONT COLOR="#53647a">TEXT</FONT></TD></TR></TABLE>>];
"inquiries" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#ccd5df"><TR><TD COLSPAN="2" BGCOLOR="#f0f1f3"><B>inquiries</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">DDL 정의</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="inquiry_id_in">inquiry_id</TD><TD WIDTH="95" ALIGN="LEFT" PORT="inquiry_id_out"><FONT COLOR="#53647a">PK</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="employee_id_in">employee_id</TD><TD WIDTH="95" ALIGN="LEFT" PORT="employee_id_out"><FONT COLOR="#53647a">TEXT</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="question_in">question</TD><TD WIDTH="95" ALIGN="LEFT" PORT="question_out"><FONT COLOR="#53647a">TEXT</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="answer_in">answer</TD><TD WIDTH="95" ALIGN="LEFT" PORT="answer_out"><FONT COLOR="#53647a">TEXT</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="category_in">category</TD><TD WIDTH="95" ALIGN="LEFT" PORT="category_out"><FONT COLOR="#53647a">TEXT</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="created_at_in">created_at</TD><TD WIDTH="95" ALIGN="LEFT" PORT="created_at_out"><FONT COLOR="#53647a">TEXT</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="status_in">status</TD><TD WIDTH="95" ALIGN="LEFT" PORT="status_out"><FONT COLOR="#53647a">TEXT</FONT></TD></TR></TABLE>>];
