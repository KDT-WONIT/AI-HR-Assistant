"leave_usage" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#ccd5df"><TR><TD COLSPAN="2" BGCOLOR="#f0f1f3"><B>leave_usage</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">DDL 정의</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="usage_id_in">usage_id</TD><TD WIDTH="95" ALIGN="LEFT" PORT="usage_id_out"><FONT COLOR="#53647a">PK</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="employee_id_in">employee_id</TD><TD WIDTH="95" ALIGN="LEFT" PORT="employee_id_out"><FONT COLOR="#53647a">TEXT</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="leave_type_in">leave_type</TD><TD WIDTH="95" ALIGN="LEFT" PORT="leave_type_out"><FONT COLOR="#53647a">TEXT</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="used_on_in">used_on</TD><TD WIDTH="95" ALIGN="LEFT" PORT="used_on_out"><FONT COLOR="#53647a">TEXT</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="days_in">days</TD><TD WIDTH="95" ALIGN="LEFT" PORT="days_out"><FONT COLOR="#53647a">NUMERIC</FONT></TD></TR><TR><TD WIDTH="170" ALIGN="LEFT" PORT="status_in">status</TD><TD WIDTH="95" ALIGN="LEFT" PORT="status_out"><FONT COLOR="#53647a">TEXT</FONT></TD></TR></TABLE>>];
