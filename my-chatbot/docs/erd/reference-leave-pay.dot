digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.8", nodesep="0.4", ranksep="0.65", splines=polyline, fontname="Malgun Gothic", fontsize=23, label="원본 전사 DB · leave-pay", labelloc=t, labeljust=l];
node [shape=plain, fontname="Arial", fontsize=14];
edge [dir=both, color="#7b8ba1", penwidth=1.15, arrowsize=0.75, fontname="Malgun Gothic", fontsize=11];
"employees" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#ccd5df"><TR><TD COLSPAN="2" BGCOLOR="#f0f1f3"><B>employees</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="11">DDL 정의</FONT></TD></TR><TR><TD WIDTH="173.60000000000002" ALIGN="LEFT" PORT="employee_id_in">employee_id</TD><TD WIDTH="95" ALIGN="LEFT" PORT="employee_id_out"><FONT COLOR="#53647a">PK</FONT></TD></TR><TR><TD WIDTH="173.60000000000002" ALIGN="LEFT" PORT="employee_name_in">employee_name</TD><TD WIDTH="95" ALIGN="LEFT" PORT="employee_name_out"><FONT COLOR="#53647a">VARCHAR(40)</FONT></TD></TR><TR><TD WIDTH="173.60000000000002" ALIGN="LEFT" PORT="grade_in">grade</TD><TD WIDTH="95" ALIGN="LEFT" PORT="grade_out"><FONT COLOR="#53647a">VARCHAR(25)</FONT></TD></TR><TR><TD WIDTH="173.60000000000002" ALIGN="LEFT" PORT="hire_date_in">hire_date</TD><TD WIDTH="95" ALIGN="LEFT" PORT="hire_date_out"><FONT COLOR="#53647a">DATE</FONT></TD></TR><TR><TD WIDTH="173.60000000000002" ALIGN="LEFT" PORT="employment_type_in">employment_type</TD><TD WIDTH="95" ALIGN="LEFT" PORT="employment_type_out"><FONT COLOR="#53647a">VARCHAR(30)</FONT></TD></TR><TR><TD WIDTH="173.60000000000002" ALIGN="LEFT" PORT="employment_status_in">employment_status</TD><TD WIDTH="95" ALIGN="LEFT" PORT="employment_status_out"><FONT COLOR="#53647a">VARCHAR(20)</FONT></TD></TR></TABLE>>];
