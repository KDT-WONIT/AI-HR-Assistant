erDiagram
    direction LR
    conversations {
        string id PK
        string employee_id
        string status
        string created_at
        string ended_at
        string end_result
    }
    departments {
        string dept_id PK
        string dept_name UK
        string parent_dept_id FK
        string dept_function
        string location
        string main_extension
        int is_active
    }
    duty_roles {
        string role_id PK
        string role_name
        string role_category
        string description
        string security_level
    }
    employee_assignments {
        string assignment_id PK
        string employee_id FK
        string dept_id FK
        string position_title
        string start_date
        string end_date
        int is_primary
    }
    employee_contacts {
        string employee_id PK, FK
        string work_email UK
        string extension_number
        string work_location
        string contact_visibility
        string photo_path
        string photo_url
        string photo_status
        string photo_source
        string photo_alt
        string source_page_url
        string license_url
        string fallback_photo_path
        string photo_file_status
    }
    employee_roles {
        string employee_role_id PK
        string employee_id FK
        string role_id FK
        string start_date
        string end_date
    }
    employees {
        string employee_id PK
        string name
        string department
        string job_title
        string hired_at
        string grade
        string employment_type
        string employment_status
        string created_at
    }
    feedback {
        int id PK
        string conversation_id FK, UK
        string rating
        string comment
        string created_at
    }
    leave_balance_details {
        string employee_id PK, FK
        int balance_year PK
        decimal base_days
        decimal carryover_days
        decimal adjusted_days
    }
    leave_balances {
        string employee_id PK, FK
        int balance_year PK
        decimal granted_days
        decimal used_days
        string updated_at
    }
    leave_transactions {
        string transaction_id PK
        string employee_id FK
        string leave_type
        int deducts_annual_leave
        string start_date
        string end_date
        decimal days
        string status
        string requested_at
    }
    messages {
        int sequence_id PK
        string id UK
        string conversation_id FK
        string role
        string content
        string sources
        string tools_used
        string context_data
        string created_at
    }
    policy_documents {
        string id PK
        string domain
        string filename
        string version
        string effective_date
        string file_path
        string created_at
    }
    webhook_events {
        string event_id PK
        string conversation_id FK, UK
        string event_type
        string payload
        string status
        int attempts
        string last_error
        string created_at
        string sent_at
    }
    departments o|--o{ departments : "parent_dept_id"
    departments ||--o{ employee_assignments : "dept_id"
    employees ||--o{ employee_assignments : "employee_id"
    employees ||--o| employee_contacts : "employee_id"
    duty_roles ||--o{ employee_roles : "role_id"
    employees ||--o{ employee_roles : "employee_id"
    conversations ||--o| feedback : "conversation_id"
    employees ||--o{ leave_balance_details : "employee_id"
    employees ||--o{ leave_balances : "employee_id"
    employees ||--o{ leave_transactions : "employee_id"
    conversations ||--o{ messages : "conversation_id"
    conversations ||--o| webhook_events : "conversation_id"
