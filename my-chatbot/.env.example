# 데이터 저장과 답변 생성은 독립적으로 선택합니다.
APP_MODE=live
STORAGE_BACKEND=sqlite
# 질문/답변 각각 1개로 계산, 5~10 범위. 10개 = 약 5회 왕복.
HISTORY_MESSAGE_LIMIT=10
ANSWER_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=-1
OLLAMA_UNLOAD_ON_EXIT=true
WARM_UP=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ai_hr_assistant
MYSQL_USER=root
MYSQL_PASSWORD=
EMBEDDING_MODEL=BAAI/bge-m3
N8N_WEBHOOK_URL=https://rl0rl0rl0.app.n8n.cloud/webhook/hr-log

# 공통 경로 설정: 빈 하위 경로는 DATA_DIR 기준 자동 계산
VECTOR_BACKEND=chroma
CHROMA_COLLECTION=kdn_regulations_bge_m3_v1
DATA_DIR=./data
POLICY_DIR=
CSV_DIR=
PROCESSED_DIR=
CHUNKS_DIR=
VECTOR_DIR=
CHROMA_DIR=../kdn_regulations_rag/rag_data/chroma_db
EMBEDDING_CACHE_DIR=
FRONTEND_DIR=./frontend_v7
PROMPTS_DIR=./prompts
LOGS_DIR=./logs
DATABASE_SCHEMA_PATH=./database/schema.sql

# 사용자 프로필: auto / file / mysql
USER_DATA_SOURCE=directory
USER_DATA_PATH=

TOOL_ROUTER=ollama
EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DEVICE=cpu
SQLITE_PATH=./data/app.sqlite3
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.60
ENABLED_TOOLS=

SQLITE_SCHEMA_PATH=./database/sqlite_schema.sql
OLLAMA_ANSWER_MODEL=gemma4:e2b

# Local MCP stdio server (automatically managed by FastAPI)
MCP_TIMEOUT_SECONDS=180
N8N_TIMEOUT_SECONDS=10
N8N_ANSWER_GAP_SECONDS=3
N8N_MESSAGE_LIMIT=10
N8N_MESSAGE_MAX_CHARS=1000

# Employee profiles, departments, contacts and local avatars
EMPLOYEE_DIRECTORY_DIR=./database/employee_directory

CONTACT_RECOMMENDATION_LIMIT=2

CONTACT_ROUTING_PATH=./config/contact_topics.json

# n8n lifecycle event names
N8N_EVENT_SESSION_START=session_start
N8N_EVENT_QUESTION=question
N8N_EVENT_ANSWER=answer
N8N_EVENT_SESSION_END=end
N8N_EVENT_FEEDBACK=feedback

TRAVEL_GRADE_MAPPING_PATH=./config/travel_grades.json
UI_REGULATIONS_DIR=./data/regulations_pdf

# Structured tool/answer output: reserve tokens for the answer body
OLLAMA_THINK=false
